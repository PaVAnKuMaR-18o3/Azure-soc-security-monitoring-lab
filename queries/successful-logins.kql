// Successful Login Detection
// Windows Security Event ID: 4624

Event
| where EventID == 4624
| extend
    TargetUserName = tostring(EventData.TargetUserName),
    TargetDomainName = tostring(EventData.TargetDomainName),
    IpAddress = tostring(EventData.IpAddress),
    WorkstationName = tostring(EventData.WorkstationName),
    LogonType = tostring(EventData.LogonType)
| project
    TimeGenerated,
    Computer,
    TargetUserName,
    TargetDomainName,
    IpAddress,
    WorkstationName,
    LogonType,
    RenderedDescription
| order by TimeGenerated desc
